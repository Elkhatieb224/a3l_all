      "options": [
        {
          "ar": "وجبة طعام",
          "en": "Meals Provided",
          "tr": "Yemek"
        },
        {
          "ar": "مواصلات",
          "en": "Transport Allowance",
          "tr": "Ulaşım Desteği"
        },
        {
          "ar": "سكن",
          "en": "Housing",
          "tr": "Konaklama"
        },
        {
          "ar": "تأمين",
          "en": "Health Insurance",
          "tr": "Sağlık Sigortası"
        },
        {
          "ar": "عمولات",
          "en": "Commissions",
          "tr": "Komisyon"
        },
        {
          "ar": "مكافآت",
          "en": "Bonuses",
          "tr": "Primler"
        },
        {
          "ar": "لا يوجد",
          "en": "None",
          "tr": "Yok"
        },
        {
          "ar": "حسب الاتفاق",
          "en": "As Agreed",
          "tr": "Anlaşmaya Göre"
        }
      ]
    },
    {
      "id": "company_name",
      "type": "text",
      "required": false,
      "is_active": true,
      "label": {
        "ar": "اسم الشركة / جهة العمل",
        "en": "Company / Employer",
        "tr": "Şirket / İşveren"
      }
