{
  "version": 1,
  "description": "Custom fields template for jobs listings (الوظائف). Import from category or subcategory page in admin.",
  "fields": [
    {
      "id": "ad_title",
      "type": "text",
      "required": true,
      "is_active": true,
      "label": {
        "ar": "عنوان الإعلان",
        "en": "Listing Title",
        "tr": "İlan Başlığı"
      }
    },
    {
      "id": "description",
      "type": "textarea",
      "required": true,
      "is_active": true,
      "label": {
        "ar": "الوصف",
        "en": "Job Description",
        "tr": "İş Tanımı"
      }
    },
    {
      "id": "ad_type",
      "type": "select",
      "required": true,
      "is_active": true,
      "multiple": true,
      "label": {
        "ar": "نوع الإعلان",
        "en": "Listing Type",
        "tr": "İlan Türü"
      },
      "options": [
        {
          "ar": "فرصة عمل",
          "en": "Job Opening",
          "tr": "İş İlanı"
        },
        {
          "ar": "طلب عمل",
          "en": "Job Seeker",
          "tr": "İş Arayan"
        }
      ]
    },
    {
      "id": "employment_type",
      "type": "select",
      "required": true,
      "is_active": true,
      "label": {
        "ar": "نوع الدوام",
        "en": "Employment Type",
        "tr": "Çalışma Şekli"
      },
      "options": [
        {
          "ar": "دوام كامل",
          "en": "Full-time",
          "tr": "Tam Zamanlı"
        },
        {
          "ar": "دوام جزئي",
          "en": "Part-time",
          "tr": "Yarı Zamanlı"
        },
        {
          "ar": "مؤقت",
          "en": "Temporary",
          "tr": "Geçici"
        },
        {
          "ar": "تدريب",
          "en": "Internship",
          "tr": "Staj"
        },
        {
          "ar": "عمل حر / فريلانسر",
          "en": "Freelance",
          "tr": "Serbest Çalışma"
        }
      ]
