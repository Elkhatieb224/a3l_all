    {
      "id": "work_mode",
      "type": "select",
      "required": true,
      "is_active": true,
      "label": {
        "ar": "نظام العمل",
        "en": "Work Arrangement",
        "tr": "Çalışma Modeli"
      },
      "options": [
        {
          "ar": "من مقر العمل",
          "en": "On-site",
          "tr": "Ofisten"
        },
        {
          "ar": "ميداني",
          "en": "Field Work",
          "tr": "Saha Çalışması"
        },
        {
          "ar": "عن بعد",
          "en": "Remote",
          "tr": "Uzaktan"
        }
      ]
    },
    {
      "id": "expected_salary",
      "type": "text",
      "required": false,
      "is_active": true,
      "label": {
        "ar": "الراتب / الأجر المتوقع",
        "en": "Expected Salary",
        "tr": "Beklenen Ücret"
      }
    },
    {
      "id": "currency",
      "type": "select",
      "required": false,
      "is_active": true,
      "label": {
        "ar": "العملة",
        "en": "Currency",
        "tr": "Para Birimi"
      },
      "options": [
        {
          "ar": "دولار",
          "en": "US Dollar",
          "tr": "ABD Doları"
        },
        {
