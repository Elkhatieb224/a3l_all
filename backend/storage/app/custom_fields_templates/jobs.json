          "tr": "Günlük"
        },
        {
          "ar": "بالساعة",
          "en": "Hourly",
          "tr": "Saatlik"
        },
        {
          "ar": "بالعمولة",
          "en": "Commission-based",
          "tr": "Komisyonlu"
        },
        {
          "ar": "لكل مشروع",
          "en": "Per Project",
          "tr": "Proje Başına"
        },
        {
          "ar": "حسب الاتفاق",
          "en": "Negotiable",
          "tr": "Anlaşmaya Göre"
        }
      ]
    },
    {
      "id": "experience",
      "type": "select",
      "required": true,
      "is_active": true,
      "label": {
        "ar": "الخبرة",
        "en": "Experience Level",
        "tr": "Deneyim Düzeyi"
      },
      "options": [
        {
          "ar": "بدون خبرة",
          "en": "No Experience",
          "tr": "Deneyimsiz"
        },
        {
          "ar": "أقل من سنة",
          "en": "Less than 1 Year",
          "tr": "1 Yıldan Az"
        },
        {
          "ar": "سنة - 3 سنوات",
          "en": "1–3 Years",
          "tr": "1–3 Yıl"
        },
        {
          "ar": "3 - 5 سنوات",
          "en": "3–5 Years",
          "tr": "3–5 Yıl"
        },
        {
          "ar": "أكثر من 5 سنوات",
          "en": "Over 5 Years",
          "tr": "5 Yıldan Fazla"
        }
      ]
    },
    {
      "id": "education",
      "type": "select",
      "required": false,
      "is_active": true,
      "label": {
        "ar": "المؤهل العلمي",
        "en": "Education Level",
        "tr": "Eğitim Durumu"
      },
      "options": [
        {
          "ar": "غير مطلوب",
          "en": "Not Required",
          "tr": "Gerekli Değil"
        },
        {
          "ar": "ابتدائي",
          "en": "Primary School",
          "tr": "İlkokul"
        },
        {
          "ar": "إعدادي",
          "en": "Middle School",
          "tr": "Ortaokul"
        },
        {
          "ar": "ثانوي",
          "en": "High School",
          "tr": "Lise"
        },
        {
          "ar": "معهد",
          "en": "Vocational / Institute",
          "tr": "Meslek Enstitüsü"
        },
        {
          "ar": "جامعة",
          "en": "Bachelor's Degree",
          "tr": "Lisans"
        },
        {
          "ar": "دراسات عليا",
          "en": "Postgraduate",
          "tr": "Lisansüstü"
        }
      ]
