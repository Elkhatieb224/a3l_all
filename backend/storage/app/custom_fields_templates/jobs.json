    {
      "id": "languages",
      "type": "select",
      "required": false,
      "is_active": true,
      "multiple": true,
      "label": {
        "ar": "اللغات",
        "en": "Languages",
        "tr": "Diller"
      },
      "options": [
        {
          "ar": "العربية",
          "en": "Arabic",
          "tr": "Arapça"
        },
        {
          "ar": "التركية",
          "en": "Turkish",
          "tr": "Türkçe"
        },
        {
          "ar": "الإنجليزية",
          "en": "English",
          "tr": "İngilizce"
        },
        {
          "ar": "الكردية",
          "en": "Kurdish",
          "tr": "Kürtçe"
        },
        {
          "ar": "أخرى",
          "en": "Other",
          "tr": "Diğer"
        }
      ]
