# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Libraries / dependencies (Composer/npm/CocoaPods — not Laravel views/vendor)
/backend/vendor/
**/node_modules/
**/.pub-cache/
**/.pub/
**/ios/Pods/
**/macos/Pods/
**/.symlinks/

# Flutter / Dart tool & build outputs
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.*
app.*.symbols
app.*.map.json

# Backend caches / temp
**/.phpunit.cache
**/phpunit.result.cache
**/bootstrap/cache/*.php
!**/bootstrap/cache/.gitignore
**/storage/framework/cache/data/*
!**/storage/framework/cache/data/.gitignore
**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitignore
**/storage/framework/views/*
!**/storage/framework/views/.gitignore
**/storage/logs/*
!**/storage/logs/.gitignore

# Duplicate / oversized archive (source tree already included)
/flutter.zip

# Logs
*.log
npm-debug.log
yarn-error.log

# IDE (optional local)
**/.fleet/
**/.idea/
**/.vscode/
**/*.iml
